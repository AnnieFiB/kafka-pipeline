# Stock Data Producer Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the producer script
COPY extract.py .

# Create a startup script
RUN echo '#!/bin/bash\n\
echo "Waiting for Kafka to be ready..."\n\
while ! nc -z kafka 9092; do\n\
  echo "Kafka is unavailable - sleeping"\n\
  sleep 2\n\
done\n\
echo "Kafka is up - executing producer"\n\
python extract.py' > start_producer.sh

RUN chmod +x start_producer.sh

# Install netcat for health check
RUN apt-get update && apt-get install -y netcat-traditional && rm -rf /var/lib/apt/lists/*

# Run the producer
CMD ["./start_producer.sh"]
